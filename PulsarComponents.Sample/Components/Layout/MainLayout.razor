@inherits LayoutComponentBase
@inject IPulsarThemeManager ThemeManager
@implements IDisposable

<PulsarThemeProvider Theme="@ThemeManager.CurrentTheme">
    @Body

    <PulsarWindowHost />
    <PulsarToastHost />
</PulsarThemeProvider>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeManager.Changed += HandleThemeChanged;
    }

    // JS interop (the theme manager's localStorage-backed LoadAsync) needs the circuit attached
    // first — same reasoning PulsarComponents.Docs' own MainLayout already applies.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeManager.LoadAsync();
            StateHasChanged();
        }
    }

    private void HandleThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeManager.Changed -= HandleThemeChanged;
}
