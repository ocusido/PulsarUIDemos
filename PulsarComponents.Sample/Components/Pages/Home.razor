@page "/"

<PageTitle>PulsarComponents Sample</PageTitle>

<div class="gallery">
    <div class="gallery__header">
        <PulsarIcon Icon="@PulsarIcons.Outline.Bolt" Color="PulsarColor.Primary" Size="PulsarSize.Large" />
        <div>
            <PulsarText Variant="PulsarTextVariant.H4" Class="gallery__title">PulsarComponents Sample</PulsarText>
            <PulsarText Variant="PulsarTextVariant.Body1" Color="PulsarColor.Neutral">
                Pick an example to see a working app built entirely with <code>PulsarComponents</code>.
            </PulsarText>
        </div>
    </div>

    <PulsarGrid Spacing="3" Class="gallery__grid">
        @foreach (var example in Examples)
        {
            <PulsarGridItem Xs="12" Sm="6" Md="4">
                @if (example.Href is not null)
                {
                    <a href="@example.Href" class="gallery__tile-link">
                        <PulsarCard Class="gallery__tile" Elevation="PulsarElevation.Low" Title="@example.Title" Subtitle="@example.Description">
                            <HeaderIcon><PulsarIcon Icon="@example.Icon" Color="PulsarColor.Primary" /></HeaderIcon>
                        </PulsarCard>
                    </a>
                }
                else
                {
                    <PulsarCard Class="gallery__tile gallery__tile--disabled" Title="@example.Title" Subtitle="@example.Description">
                        <HeaderIcon><PulsarIcon Icon="@example.Icon" Color="PulsarColor.Neutral" /></HeaderIcon>
                        <Actions><PulsarChip Size="PulsarSize.Small">Coming soon</PulsarChip></Actions>
                    </PulsarCard>
                }
            </PulsarGridItem>
        }
    </PulsarGrid>
</div>

@code {
    private sealed record Example(string Title, string Description, string Icon, string? Href);

    private static readonly Example[] Examples =
    [
        new("Dashboard", "Stat cards, tags, toast/window actions.", PulsarIcons.Outline.LayoutDashboard, "examples/dashboard"),
        new("Calendar & Scheduling", "Month/week views, events, drag-to-reschedule.", PulsarIcons.Outline.Calendar, null),
        new("Data Grid / Admin Table", "Sortable, filterable, inline-editable rows.", PulsarIcons.Outline.Table, null),
        new("Settings & Forms", "Validated forms, reactive controls.", PulsarIcons.Outline.Settings, null),
        new("E-commerce Catalog", "Product grid, filters, cart.", PulsarIcons.Outline.ShoppingCart, null),
        new("Kanban Board", "Drag-and-drop columns and cards.", PulsarIcons.Outline.LayoutKanban, null),
        new("Chat / Messaging", "Conversation list and message thread.", PulsarIcons.Outline.MessageCircle, null),
        new("Analytics Dashboard", "Charts-heavy reporting view.", PulsarIcons.Outline.ChartBar, null),
        new("Onboarding Wizard", "Multi-step form with a Stepper.", PulsarIcons.Outline.ListCheck, null),
        new("File Manager", "Folder tree, file list, previews.", PulsarIcons.Outline.Folder, null),
    ];
}
